{
  "name": "andaman-trails-fullstack",
  "version": "1.0.0",
  "description": "Full-Stack Travel Platform for Andaman Trails (React + Redux Toolkit + Three.js + Express + MySQL + Sequelize)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build && node -e \"const fs=require('fs'); fs.cpSync('client/dist', 'dist', {recursive:true});\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "start": "npm --prefix server run start",
    "db:setup": "npm --prefix server run db:setup"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axios": "^1.19.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0"
  },
  "keywords": [
    "andaman-trails",
    "react",
    "redux-toolkit",
    "threejs",
    "express",
    "mysql",
    "sequelize"
  ],
  "author": "Andaman Trails Team",
  "license": "ISC"
}
