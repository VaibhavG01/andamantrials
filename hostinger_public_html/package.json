{
  "name": "andaman-trails-fullstack",
  "version": "1.0.0",
  "description": "Full-Stack Travel Platform for Andaman Trails (React + Redux Toolkit + Three.js + Express + MySQL + Sequelize)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client install && npm --prefix client run build && node -e \"const fs=require('fs'); fs.cpSync('client/dist', 'dist', {recursive:true});\"",
    "postinstall": "node -e \"console.log('Postinstall ready')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.3",
    "slugify": "^1.6.6",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "andaman-trails",
    "react",
    "redux-toolkit",
    "threejs",
    "express",
    "mysql",
    "sequelize"
  ],
  "author": "Andaman Trails Team",
  "license": "ISC"
}
