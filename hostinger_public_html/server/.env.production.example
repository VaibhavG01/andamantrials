# ─────────────────────────────────────────────────────────────────────────────
# ANDAMAN TRAILS — PRODUCTION ENVIRONMENT CONFIGURATION (HOSTINGER)
# ─────────────────────────────────────────────────────────────────────────────

# Server Port & Environment
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1

# Frontend Application URL (Replace with your live domain)
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# Database Dialect: Choose 'mysql' (Recommended for Hostinger MySQL) or 'sqlite'
DB_DIALECT=mysql
USE_SQLITE=false

# Hostinger MySQL Database Credentials (Created from Hostinger hPanel -> Databases -> MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_andaman
DB_USER=u123456789_admin
DB_PASSWORD=YourStrongDatabasePassword123!

# JWT Security Secrets (Generate a long random secure string)
JWT_SECRET=andaman_trails_production_super_secure_jwt_token_key_2026_x89!#
JWT_EXPIRES_IN=7d

# Razorpay Live Payment Gateway Keys (From Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_your_actual_live_key
RAZORPAY_KEY_SECRET=your_actual_live_secret

# SMTP Email Service Configuration (Hostinger Email / Gmail / Brevo)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=bookings@yourdomain.com
SMTP_PASSWORD=YourEmailPassword123!
MAIL_FROM="Andaman Trails <bookings@yourdomain.com>"

# Cloudinary Storage Configuration (Optional - for cloud image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
