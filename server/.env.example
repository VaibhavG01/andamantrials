# Andaman Trails Backend Configuration

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=andaman_trails
DB_USER=root
DB_PASSWORD=rootpassword

# JWT Authentication
JWT_SECRET=super_secret_andaman_trails_jwt_token_key_2026
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=andaman_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your_cloudinary_secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@andamantrails.com
SMTP_PASSWORD=smtp_password
MAIL_FROM="Andaman Trails <noreply@andamantrails.com>"

# Frontend Application URL
FRONTEND_URL=http://localhost:5173
